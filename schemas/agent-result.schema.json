{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e2e-agentdev.dev/schemas/agent-result.schema.json",
  "title": "/task/result.json",
  "description": "Written once by the runtime when it stops (docs/contracts/agent-task.md). Deserialized into guard_core::ports::TaskResult. The diff is not reported here: the orchestrator extracts it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "summary", "usage", "cost_usd", "steps"],
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": { "$ref": "#/$defs/count" },
        "output_tokens": { "$ref": "#/$defs/count" },
        "cached_input_tokens": { "$ref": "#/$defs/count" },
        "cache_creation_input_tokens": { "$ref": "#/$defs/count" }
      }
    }
  },
  "properties": {
    "version": { "const": 1 },
    "status": { "enum": ["completed", "failed", "budget_exceeded", "timed_out", "refused"] },
    "summary": { "type": "string", "maxLength": 4000 },
    "usage": { "$ref": "#/$defs/usage" },
    "cost_usd": { "type": "number", "minimum": 0 },
    "steps": { "$ref": "#/$defs/count" },
    "memory_proposals": {
      "description": "Suggestions only: they go to the human-approval candidate queue (memory.md).",
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["topic_key", "body"],
        "properties": {
          "topic_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$", "maxLength": 120 },
          "body": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "evidence": { "type": "string" }
        }
      }
    },
    "error": { "type": "string" }
  }
}
