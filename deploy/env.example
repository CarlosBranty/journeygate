# Template for deploy/.env (git-ignored): cp deploy/env.example deploy/.env
# Compose reads deploy/.env because deploy/ is the project directory of
# deploy/docker-compose.yml. Names only here: never commit real values.
# Generate secrets with `openssl rand -hex 32`. Use URL-safe values (hex is):
# POSTGRES_PASSWORD, S3_ACCESS_KEY and S3_SECRET_KEY are placed inside URLs
# without percent-encoding.

# ---- required -------------------------------------------------------------
# Absolute path of the app checkout guard serves (target.toml, catalog).
GUARD_REPO_DIR=
GUARD_SERVER_TOKEN=
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# DNS name of this host as evidence readers (browsers, Jira, the PR) reach it,
# e.g. guard.example.internal. Evidence links point at http://<it>:8333/.
# Not localhost: inside the stack that name is the guard container itself.
S3_PUBLIC_HOST=

# ---- optional: server -----------------------------------------------------
# Host port for guard serve (default 8080).
GUARD_PORT=
GUARD_DASHBOARD_TOKEN=
GUARD_STALENESS_INTERVAL=
# Bucket name (default guard-evidence) and its retention (default 14d; keep it
# equal to [evidence].retention_days).
S3_BUCKET=
S3_EVIDENCE_TTL=
GUARD_MEMORY_READ_DATABASE_URL=

# ---- optional: decision engine (Jev) --------------------------------------
TYPESAFE_API_KEY=
JEV_URL=

# ---- optional: Jira ---------------------------------------------------------
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_SUGGESTED_FIELD=
# Custom field holding acceptance criteria (e.g. customfield_10050).
JIRA_ACCEPTANCE_CRITERIA_FIELD=
JIRA_PRE_EXISTING_PRIORITY=
GUARD_JIRA_WEBHOOK_SECRET=

# ---- optional: code host ([code_host].kind in target.toml) ------------------
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_API_URL=
GUARD_GITHUB_WEBHOOK_SECRET=
GITLAB_TOKEN=
GITLAB_PROJECT=
GITLAB_API_URL=
GUARD_GITLAB_WEBHOOK_SECRET=

# ---- profile "agents": model gateway ----------------------------------------
LITELLM_MASTER_KEY=
REDIS_PASSWORD=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=

# ---- agent lane override (docker-compose.agents.yml) -----------------------
# Numeric gid of the host's docker group: getent group docker | cut -d: -f3
DOCKER_GID=
# Same absolute path on the host and in the container, writable by uid 10001.
GUARD_AGENT_WORK_DIR=
GUARD_SANDBOX_RUNTIME=
GUARD_AGENTS_TOML=
GUARD_AGENT_KEEP_WORK=
GUARD_REPO=
